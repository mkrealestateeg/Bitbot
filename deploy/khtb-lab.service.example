[Unit]
Description=Khtb Lab Telegram Crypto Research Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=khtblab
WorkingDirectory=/opt/khtb-lab
EnvironmentFile=/opt/khtb-lab/.env
ExecStart=/opt/khtb-lab/.venv/bin/python /opt/khtb-lab/main.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/khtb-lab/data

[Install]
WantedBy=multi-user.target
